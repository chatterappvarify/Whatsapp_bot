# Your WhatsApp number (with country code, no + sign or spaces)
# Example: 263784868165
WA_PHONE_NUMBER=263784868165

# Secret API key — your ChatterApp will send this in every request
# Change this to something long and random, e.g: chatterapp_secret_x9k2m7p
API_KEY=chatterapp_secret_x9k2m7p

# Port (Replit sets this automatically, leave as 3000)
PORT=3000
